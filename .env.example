# Copy to .env and adjust. `docker compose up` reads it automatically.

# Public origin as users reach it (behind TLS in production).
BOARDS_PUBLIC_URL=http://localhost:8080

# Bind to all interfaces only when auth is on.
BOARDS_BIND=127.0.0.1
BOARDS_PORT=8080

# token | oidc | proxy | none
BOARDS_AUTH=token
# Generate with: openssl rand -hex 32   (comma-separate several)
BOARDS_API_TOKENS=
# Generate with: openssl rand -hex 32
BOARDS_SESSION_SECRET=

MINIO_ROOT_USER=boards
MINIO_ROOT_PASSWORD=change-me-minio-secret
