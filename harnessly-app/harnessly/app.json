{
  "id": "harnessly.boards",
  "name": "Доски",
  "description": "Доски Excalidraw: агент читает доску как текст, рисует схему графом, дорисовывает и отвечает в комментариях",
  "version": "0.4.0",
  "harnessly": ">=0.16.68",
  "trust": "sandboxed",
  "targets": [
    "app",
    "pane",
    "chat"
  ],
  "activation": {
    "on": [
      "manual"
    ],
    "openView": "board"
  },
  "permissions": [
    "chat.prompt",
    "pane.open",
    "context.publish"
  ],
  "agent": {
    "instructions": "instructions.md",
    "skills": [
      "boards"
    ],
    "tools": {}
  },
  "views": [
    {
      "id": "board",
      "title": "Boards",
      "entry": "${install:boardsUrl}/b/app",
      "targets": [
        "app",
        "pane"
      ]
    }
  ],
  "network": {
    "frames": [
      "${install:boardsUrl}"
    ]
  }
}
